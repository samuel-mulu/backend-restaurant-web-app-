# 3T Juice House — production env template
# On the VPS: copy to `.env` in this repo, fill secrets, then start Compose
# with `--env-file .env`. Never point this file at Atlas or any other stack.

# --- Compose / API ---
NODE_ENV=production
PORT=5000

# --- Mongo (Docker only, database name 3t_juice_house) ---
# Use letters, numbers, hyphen, and underscore only. Avoid @ : / ? # %
MONGO_ROOT_USERNAME=three_t_mongo_root
MONGO_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM_ROOT_PASSWORD
MONGO_APP_USERNAME=three_t_api
MONGO_APP_PASSWORD=CHANGE_ME_LONG_RANDOM_APP_PASSWORD
MONGO_APP_DATABASE=3t_juice_house
MONGO_REPLICA_HOST=3t-juice-house-mongo:27017

# Compose overrides MONGO_URI so the API cannot accidentally use Atlas/Tekeze.
# Kept here only as documentation of the in-network replica-set URI:
# MONGO_URI=mongodb://three_t_api:CHANGE_ME_LONG_RANDOM_APP_PASSWORD@3t-juice-house-mongo:27017/3t_juice_house?authSource=3t_juice_house&replicaSet=rs0&retryWrites=true&w=majority

# --- JWT (required) ---
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_BYTE_HEX
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Cloudinary (required at process start — missing values crash boot) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# --- CORS (production blocks unknown origins) ---
# Express uses CORS_ORIGIN plus a few hardcoded frontend URLs.
# Socket.IO uses CORS_ORIGINS only (comma-separated, no spaces).
CORS_ORIGIN=https://YOUR_3T_FRONTEND_DOMAIN
CORS_ORIGINS=https://YOUR_3T_FRONTEND_DOMAIN

# Cookies: production already sets Secure + SameSite=None when NODE_ENV=production.
# COOKIE_DOMAIN is loaded but not applied by the current cookie helper.
COOKIE_DOMAIN=
SECURE_COOKIES=true

# --- Optional ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=3T Juice House
SMTP_FROM_EMAIL=

# POS printer runs on cashier PCs, not on this VPS.
POS_PRINTER_URL=http://localhost:7777
POS_PRINTER_KEY=CHANGE_ME_POS_KEY

RESTAURANT_LAT=0
RESTAURANT_LNG=0
ALLOWED_RADIUS_METERS=500
