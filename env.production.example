# Tekeze Lounge API — production environment template
# Copy to `.env` next to docker-compose.prod.yml on the VPS.
# Do not commit `.env`. Do not reuse Atlas credentials or repo JWT values.
#
# Generate secrets, for example:
#   openssl rand -hex 64
# Use alphanumeric Mongo passwords so they are safe inside MONGO_URI.

NODE_ENV=production
PORT=5000

# Candidate localhost publish. Confirm free with: ss -lntp
# If 5100 is taken, set another unused port here (compose binds 127.0.0.1 only).
TEKEZE_API_HOST_PORT=5100

# Isolated Docker Mongo — new database, not Atlas
MONGO_ROOT_USERNAME=tekeze_lounge
MONGO_ROOT_PASSWORD=CHANGE_ME_ALPHANUMERIC_PASSWORD
MONGO_DATABASE=tekeze_lounge

# JWT — generate new values; do not copy from env.example / render.yaml
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_64
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_HEX_64
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# HTTP CORS (src/config/corsOptions.ts). Set the real frontend origin.
CORS_ORIGIN=https://CHANGE_ME_FRONTEND_ORIGIN

# Socket.IO CORS (src/server.ts). Comma-separated, no spaces. Do not use *.
CORS_ORIGINS=https://CHANGE_ME_FRONTEND_ORIGIN

COOKIE_DOMAIN=CHANGE_ME_API_DOMAIN
SECURE_COOKIES=true

# Required at process start (src/config/cloudinary.ts throws if missing)
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_URL=cloudinary://CHANGE_ME:CHANGE_ME@CHANGE_ME

# Loaded by the app; optional if email is unused
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM_NAME=Tekeze Lounge
SMTP_FROM_EMAIL=CHANGE_ME

# Cashier PCs run the printer locally; leave defaults unless you override
POS_PRINTER_URL=http://localhost:7777
POS_PRINTER_KEY=CHANGE_ME

RESTAURANT_LAT=0
RESTAURANT_LNG=0
ALLOWED_RADIUS_METERS=500
