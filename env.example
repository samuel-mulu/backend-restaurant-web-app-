# JWT Configuration
JWT_SECRET=2efefda868a4ab5e6dfefd9b4ac7d89eafb1d72f8d1ad402b0736ed35d8aee93c90ffdccbef2dc7e9bcc40b9d57bb8805164d453d40cd59cf96242bafa29fc76
