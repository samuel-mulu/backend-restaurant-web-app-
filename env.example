# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=name
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=secret
CLOUDINARY_URL=cloudinary://key:secret@name

# CORS and Cookies
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost
SECURE_COOKIES=false

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Menu App
SMTP_FROM_EMAIL=your-email@gmail.com

# POS Printer Service Configuration (Optional - defaults to localhost)
# Each cashier PC runs both backend and POS service locally
# No IP configuration needed - always uses localhost:7777
POS_PRINTER_URL=http://localhost:7777
POS_PRINTER_KEY=dev-key-12345

